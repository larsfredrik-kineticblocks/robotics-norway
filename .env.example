# Copy to .env.local. Never commit real secrets.

# Postgres connection string (Neon, Vercel Postgres, or any Postgres).
# Leave unset to render the bundled founding list.
DATABASE_URL=

# Auth.js. Required in production before Google sign-in will open.
# Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth client for the admin area.
# Redirect URI: https://roboticsnorway.org/api/auth/callback/google
# Also add each Vercel preview origin you use, plus http://localhost:4317 for local sign-in.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated extra administrator emails.
# lars.fredrik@kineticblocks.com is always included.
ADMIN_EMAILS=

# Public site URL used for metadata and the sitemap.
NEXT_PUBLIC_SITE_URL=https://roboticsnorway.org

# Optional. Used only by `npm run drive:sync` to refresh data/documents.json.
# JSON string, or a path to the service-account JSON file.
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_FOLDER_ID=0AOC8ZRNR_c8xUk9PVA
